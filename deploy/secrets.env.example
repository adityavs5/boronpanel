# Reference copy of Boron Panel's root-only secrets file. Real deployments
# install this at /etc/boron/secrets.env, mode 0600, owned root:root — only
# `borond` (the root provisioning daemon) ever reads it. NEVER commit the
# real file to git (it's gitignored by *.env / *secrets*.env in .gitignore);
# this .example file exists so operators know exactly what keys are needed
# without ever seeing a real value. See README.md "Configuration files" for
# the full setup runbook, including the exact `openssl rand` commands used
# to generate each of these on a real install.
#
# Format: plain KEY=VALUE lines, no quoting, blank lines and #-comments
# ignored (shared/config.py's _load_secrets).

# MariaDB root password, set during initial MariaDB hardening. Only needed
# by the setup runbook itself, not read by the daemon at runtime.
MARIADB_ROOT_PASSWORD=REPLACE_WITH_OPENSSL_RAND_BASE64_32

# The forgehost_daemon (MariaDB admin-equivalent) user's password -- the
# credential borond authenticates as for every hosted-database operation.
MARIADB_DAEMON_PASSWORD=REPLACE_WITH_OPENSSL_RAND_BASE64_32

# The forgehost_mailro (SELECT-only) user's password -- embedded in
# Postfix's/Dovecot's own SQL config, not just here.
MARIADB_MAILRO_PASSWORD=REPLACE_WITH_OPENSSL_RAND_HEX_24

# PowerDNS REST API key (only needed if using the self-hosted PowerDNS
# provider, the default).
POWERDNS_API_KEY=REPLACE_WITH_OPENSSL_RAND_HEX_24

# Cloudflare API token (only needed if any account/domain uses the
# Cloudflare DNS provider). Scoped token, not the global API key -- see
# docs/ARCHITECTURE.md for the exact permission set required.
# CLOUDFLARE_API_TOKEN=REPLACE_WITH_REAL_CLOUDFLARE_SCOPED_TOKEN

# Fernet key encrypting Node/Python app environment variables at rest
# (daemon/appcrypto.py). Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# APP_ENV_KEY=REPLACE_WITH_GENERATED_FERNET_KEY
