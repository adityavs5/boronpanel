[Unit]
Description=Boron REST API + admin UI (unprivileged)
After=network.target boron-provisiond.service
Wants=boron-provisiond.service

[Service]
Type=simple
User=boron-api
Group=boron-api
ExecStart=/opt/boron/.venv/bin/uvicorn api.main:app --host 0.0.0.0 --port 9443 --ssl-keyfile /etc/boron/ssl/api/panel.key --ssl-certfile /etc/boron/ssl/api/panel.crt
WorkingDirectory=/opt/boron
Environment=PYTHONPATH=/opt/boron
Environment=BORON_CONFIG=/etc/boron/boron.toml
Environment=BORON_SECRETS=/etc/boron/secrets.env
Environment=BORON_API_SECRETS=/etc/boron/api-secrets.env
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
