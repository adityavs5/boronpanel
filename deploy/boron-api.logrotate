# Boron API request logs (Run A feature 7).
# Install to /etc/logrotate.d/boron-api (root:root, 0644):
#   install -m 0644 deploy/boron-api.logrotate /etc/logrotate.d/boron-api
#
# The goal's spec: daily rotation, 30 days retained, compressed, with the
# 5xx error stream kept as its own separate file.
#
# API and daemon use WatchedFileHandler, so rename/create rotation is safe and
# avoids copytruncate's line-loss race.
/var/log/boron/api-access.log
/var/log/boron/api-error.log {
    daily
    rotate 30
    compress
    delaycompress
    missingok
    notifempty
    su root boron-api
    create 0640 boron-api boron-api
}

/var/log/boron/daemon.log {
    daily
    rotate 30
    compress
    delaycompress
    missingok
    notifempty
    su root boron-api
    create 0640 root boron-api
}

/var/log/boron/updates.log
/var/log/boron/account-events.log
/var/log/boron/audit-retention.log
/var/log/boron/support-bundle-retention.log
/var/log/boron/backup-scheduler.log
/var/log/boron/certbot-renew.log
/var/log/boron/cloudflare-ranges.log
/var/log/boron/cloudflare-zone-check.log
/var/log/boron/geoip-refresh.log
/var/log/boron/health-snapshot.log
/var/log/boron/maintenance-autodisable.log
/var/log/boron/monitoring-check.log
/var/log/boron/pma-token-cleanup.log
/var/log/boron/sitestats-snapshot.log
/var/log/boron/ssl-expiry-check.log
/var/log/boron/update-check.log
/var/log/boron/usage-alert-check.log
/var/log/boron/usage-snapshot.log {
    daily
    rotate 30
    compress
    delaycompress
    missingok
    notifempty
    su root root
    create 0640 root root
}
