# Boron license refresh (shared/license.py, daemon/license_client.py).
# Install to /etc/cron.d/boron-license (root:root, 0644):
#   install -m 0644 deploy/boron-license.cron /etc/cron.d/boron-license
#
# Twice a day, with up to 30 minutes of random delay, refresh the signed
# license document. A panel keeps working for 14 days without a successful
# check, so a short license-server outage is harmless.
7 1,13 * * * root /opt/boron/scripts/license_check.py --jitter >> /var/log/boron/license-check.log 2>&1
