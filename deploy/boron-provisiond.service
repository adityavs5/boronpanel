[Unit]
Description=Boron provisioning daemon (root, Unix-socket RPC only)
After=network.target mariadb.service
Wants=mariadb.service

[Service]
Type=simple
ExecStart=/opt/boron/.venv/bin/python -m daemon.server
WorkingDirectory=/opt/boron
Environment=PYTHONPATH=/opt/boron
Environment=BORON_CONFIG=/etc/boron/boron.toml
Environment=BORON_SECRETS=/etc/boron/secrets.env
Restart=on-failure
RestartSec=3
RuntimeDirectory=boron
RuntimeDirectoryMode=0750
UMask=0027
ProtectKernelTunables=true
ProtectKernelModules=true
RestrictSUIDSGID=true
LockPersonality=true
# AF_NETLINK is required by the iptables/nft backend used to enforce the
# FileBrowser loopback owner rule during daemon bootstrap.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
