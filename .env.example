# Boron Panel local/development configuration template.
# Copy to .env only for a non-production checkout; real deployments use
# /etc/boron/boron.toml, /etc/boron/secrets.env, and
# /etc/boron/api-secrets.env with restrictive permissions. Never put real
# credentials in this file or commit a populated .env.

# Configuration file locations
BORON_CONFIG=/etc/boron/boron.toml
BORON_SECRETS=/etc/boron/secrets.env
BORON_API_SECRETS=/etc/boron/api-secrets.env

# Public panel settings (also available in boron.toml)
BORON_SERVER_PUBLIC_IP=203.0.113.10
BORON_API_BIND_HOST=0.0.0.0
BORON_API_BIND_PORT=9443
BORON_LETSENCRYPT_EMAIL=admin@example.com
BORON_DEFAULT_DNS_PROVIDER=powerdns
BORON_CLOUDFLARE_ACCOUNT_ID=REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID
BORON_UPDATE_GITHUB_REPO=adityavs5/boronpanel

# Root-only infrastructure credentials (/etc/boron/secrets.env)
MARIADB_ROOT_PASSWORD=REPLACE_WITH_RANDOM_VALUE
MARIADB_DAEMON_PASSWORD=REPLACE_WITH_RANDOM_VALUE
MARIADB_MAILRO_PASSWORD=REPLACE_WITH_RANDOM_VALUE
POWERDNS_API_KEY=REPLACE_WITH_RANDOM_VALUE
CLOUDFLARE_API_TOKEN=REPLACE_WITH_SCOPED_CLOUDFLARE_TOKEN
APP_ENV_KEY=REPLACE_WITH_FERNET_KEY

# API-readable secret (/etc/boron/api-secrets.env)
SESSION_SECRET=REPLACE_WITH_RANDOM_VALUE

# Optional integrations
MAXMIND_LICENSE_KEY=REPLACE_WITH_MAXMIND_LICENSE_KEY
SMTP_RELAY_HOST=127.0.0.1
SMTP_RELAY_PORT=25
WEBMAIL_URL=https://webmail.example.com
WEBMAIL_HOSTNAME=webmail.example.com
PMA_HOSTNAME=pma.example.com

# Runtime paths and limits are configured in deploy/boron.toml.example;
# do not place database, log, private-key, or certificate contents here.
