docRoot                   {{ docroot }}
{# Security fix (Phase 6a research finding): this was hardcoded to 1
   (follow symlinks unconditionally), the maximally-permissive setting --
   independent of namespace isolation, this let an account plant a symlink
   under its own docroot pointing at another customer's files and have OLS
   serve the target. 0 (never follow) is the correct default for shared
   hosting per this box's own installed OLS docs ("For better security,
   disable this feature" -- VirtualHosts_Help.html); no legitimate
   Boron automation (app installer, git deploy) creates or relies on a
   symlink under an account's docroot -- confirmed by grepping every
   daemon/*.py for symlink creation before making this change. #}
allowSymbolLink           0
enableGzip                1
enableIpGeo               0

{# Phase 2 feature 4: one vhost per DOMAIN now (not per account -- the
   Phase 1 gap this feature exists to fix: every domain under an account
   used to silently serve the same public_html content, since only one
   vhost existed per account no matter how many domains it had). The
   extprocessor itself stays account-scoped, not domain-scoped -- an
   account has exactly one php_version, so it's defined ONCE at server
   level in httpd_config.conf.j2 (named {{ php_app_name }}, same naming
   scheme as before) and referenced here by name only, letting every
   domain-vhost belonging to this account share one LSAPI backend/socket
   instead of spawning a redundant one per domain. #}
scripthandler {
  add                     lsapi:{{ php_app_name }} php
}

{% if error_pages %}
{# Missing-features batch, goal feature 4 (+ feature 2's own forced-503 page
   riding the same slot -- daemon/custom_pages.py's module docstring). One
   `errorpage <code>` block per known HTTP error code, always fully
   populated by daemon/ols.py's _error_pages_for_domain: a customer's own
   custom page if one exists (served from the per-domain
   /.boron-error-pages/ context below), else the shared Boron-branded
   default (/.boron-default-errors/, same URL for every vhost). #}
{% for code, url in error_pages.items() %}
errorpage {{ code }} {
  url                     {{ url }}
}
{% endfor %}
{% endif %}

{% if suspended %}
{# QA round 2, item 8 follow-up (found LIVE, on a real suspended site that
   kept serving its cached homepage through BOTH an on-disk cache purge AND
   a full lshttpd restart): merely OMITTING the vhost-level cache block
   while suspended is NOT enough to stop cached serving. The server-level
   `module cache` default has `checkPublicCache 1` + `checkPrivateCache 1`
   + `ignoreRespCacheCtrl 0` -- so (a) a response that carries its own
   `x-litespeed-cache-control: public, max-age=...` header (the LiteSpeed
   Cache WordPress plugin stamps max-age=604800, SEVEN DAYS) gets cached
   even with the default `enableCache 0`, landing in the module's DEFAULT
   storage path (top-level cachedata/, NOT this vhost's own storagepath --
   confirmed by dumping a live cache object keyed `test.coilchat.com:443/...`
   from that tree), and (b) `checkPublicCache/checkPrivateCache 1` keep
   SERVING those objects no matter what this vhost omits. The only robust
   answer is an explicit vhost-level override that turns cache LOOKUPS off,
   which works regardless of where the stale objects physically live. #}
module cache {
  enableCache             0
  enablePrivateCache      0
  checkPublicCache        0
  checkPrivateCache       0
  ignoreRespCacheCtrl     1
}
{% elif lscache %}
{# Phase 7a feature 4: LSCache, per-vhost override of the server-level
   `module cache {}` default (httpd_config.conf.j2, enableCache 0) --
   confirmed against this server's own installed OLS docs/module
   definition that module parameters ARE overridable at the Virtual Host
   level for this specific module (unlike ModSecurity, ARCHITECTURE.md
   SS10.5). storagepath is unique per vhost so daemon/lscache.py's purge()
   can delete exactly this domain's cached objects without touching any
   other domain's cache. #}
module cache {
  enableCache             1
  expireInSeconds         {{ lscache.ttl_seconds }}
  storagepath             {{ lscache.storagepath }}
  purgeUri                {{ lscache.purge_uri }}
{% for path in lscache.exclude_paths %}
  noCacheUrl              {{ path }}
{% endfor %}
}
{% endif %}

{% if protected_dirs and not suspended %}
{# Phase 4 feature 4: directory privacy, OLS's native realm/userDB
   mechanism (syntax confirmed empirically against this server's real
   OLS install -- see daemon/fileauth.py's module docstring). Skipped
   entirely while suspended: every request is rewritten to /index.html
   regardless of path in that state, so these contexts would never be
   reached, and re-including them adds nothing but vhost bloat. #}
{% for pd in protected_dirs %}
realm {{ pd.realm_name }} {
  userDB {
    location              {{ pd.htpasswd_path }}
  }
}
{% endfor %}
{% endif %}

{% if error_pages %}
{# Missing-features batch, goal feature 4: per-domain custom error pages
   (customer-uploaded, under the account's own home) and the shared
   Boron-branded defaults (bundled with the app, identical URL for
   every vhost) -- exposed as two small static contexts so the `errorpage`
   directives above have somewhere real to fetch content from, the same
   sibling-context pattern the acme-challenge path already uses. Always
   rendered (not gated on which codes actually have a custom page) since
   both directories always exist by the time a vhost is rendered
   (daemon/ols.py's ensure_pages_dir self-heals this for pre-existing
   domains) and OLS's own `-t` validates the live tree, not a
   best-effort/lazy one. #}
context /.boron-error-pages/ {
  location                {{ home_dir }}/{{ domain_name }}/error_pages/
  allowBrowse              1
}
context /.boron-default-errors/ {
  location                {{ default_error_pages_dir }}/
  allowBrowse              1
}
{% endif %}

context / {
{% if maintenance %}
  {# Missing-features batch, goal feature 2: Retry-After on every response
     in this context while maintenance is enabled -- applies to the forced
     503 below (extraHeaders is Apache mod_headers-compatible per this
     server's own installed OLS docs, Static_Context.html). #}
  extraHeaders            <<<END_boron_maint_headers
set Retry-After "{{ maintenance.retry_after_seconds }}"
END_boron_maint_headers
{% endif %}
{% if ip_block_list %}
  {# Phase 4 feature 3: IP/CIDR deny list, OLS's own native per-vhost
     access control (VHSecurity_Help.html/rails.conf's shipped example) --
     applies regardless of suspended state, since a blocked IP shouldn't
     see the suspended page either. #}
  accessControl {
    allow                 *
    deny                  {{ ip_block_list | join(', ') }}
  }
{% endif %}
{% if suspended %}
  location                {{ suspended_page_root }}
  allowBrowse             1
{% elif app_proxy %}
  {# Phase 7a features 1/2: NodeJS/Python app hosting. This whole domain
     is reverse-proxied to a systemd-supervised local backend via OLS's
     native "Web Server (Proxy)" external app (extProcessor type "web",
     declared server-wide in httpd_config.conf.j2) + this Proxy Context --
     confirmed against this server's own installed OLS docs
     (docs/Proxy_Context.html, docs/External_WS.html). Suspended still
     wins over this (checked above): a suspended account's app-backed
     domain shows the same static suspended page as a PHP one, not a
     stopped/crashing proxy target. #}
  type                    proxy
  handler                 {{ app_proxy.handler_name }}
  addDefaultCharset       off
{% else %}
  location                {{ docroot }}
  allowBrowse             1
  rewrite {
    enable                1
    RewriteFile           .htaccess
  }
  addDefaultCharset       off

  phpIniOverride  {
    {# Security fix (Phase 6a research finding): dropped the trailing
       ":/tmp" -- every account's open_basedir used to include the shared,
       world-writable-sticky system /tmp, letting one account enumerate
       every other account's temp/upload-in-progress filenames (content
       itself is uid-protected, but existence/naming/timing wasn't).
       "{{ home_dir }}/tmp" (0750, owned by this account -- created by
       sysops.ensure_tmp_dir at account-creation time, and by this same
       call from handlers_domain.ensure_docroot at domain-add time) is
       this account's own private replacement, already referenced here
       before this fix -- only the shared fallback is newly removed. #}
    php_admin_value open_basedir "{{ docroot }}:{{ home_dir }}/tmp"
    {# upload_tmp_dir defaults to empty in this build (confirmed via
       `lsphp -i`), which falls through to the same system-/tmp default
       open_basedir just excluded -- without this override, a file upload
       would immediately fail with an open_basedir violation. #}
    php_admin_value upload_tmp_dir "{{ home_dir }}/tmp"
    {# Phase 3 feature 9: a real, persistent per-account PHP error log --
       lsphp's own compiled-in php.ini has no error_log path configured
       at all (confirmed empirically: PHP fatal errors went nowhere
       durable, not even the vhost's own OLS errorlog file, while
       diagnosing an unrelated Phase 3 feature 3 bug), so without this
       PHP errors were simply lost. Unconditional (not gated on a
       PhpIniOverride row existing) -- every account gets a real error
       log to view, whether or not it has ever customized its own PHP
       ini settings. #}
    php_admin_value log_errors "On"
    php_admin_value error_log "{{ home_dir }}/logs/php-error.log"
    php_admin_value mail.log "{{ home_dir }}/logs/php-mail.log"
{% if php_ini %}
    {# Phase 3 feature 6: per-account PHP ini overrides, rendered ONLY
       into this account's own vhost context -- OLS's native per-context
       mechanism, not a system-wide php.ini edit; no other account's
       vhost ever references this account's PhpIniOverride row. #}
    php_admin_value memory_limit "{{ php_ini.memory_limit }}"
    php_admin_value upload_max_filesize "{{ php_ini.upload_max_filesize }}"
    php_admin_value post_max_size "{{ php_ini.post_max_size }}"
    php_admin_value max_execution_time "{{ php_ini.max_execution_time }}"
    php_admin_value display_errors "{{ "On" if php_ini.display_errors else "Off" }}"
    php_admin_value error_reporting "{{ php_ini.error_reporting }}"
{% for e in php_ini.get('extras') or [] %}
    {# Newer key/value directives (PhpIniDirective rows): names are
       EXTRA_DIRECTIVES registry keys only, values already validated to
       their rendered string form by phpdirectives.validate() -- neither
       side is ever raw user text. #}
    php_admin_value {{ e.name }} "{{ e.value }}"
{% endfor %}
{% endif %}
  }
{% endif %}
}

context /.well-known/acme-challenge/ {
  location                {{ docroot }}/.well-known/acme-challenge/
  allowBrowse             1
}

{% if protected_dirs and not suspended %}
{% for pd in protected_dirs %}
context /{{ pd.relative_path }}/ {
  location                {{ docroot }}/{{ pd.relative_path }}/
  allowBrowse             1
  realm                   {{ pd.realm_name }}
  authName                "Protected Area"
}
{% endfor %}
{% endif %}

rewrite {
  enable                  1
  autoLoadHtaccess        {{ 0 if (suspended or maintenance or forwarding) else 1 }}
{% if suspended %}
  rules                   <<<END_boron_rules
RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
RewriteRule ^(.*)$ /index.html [L]
END_boron_rules
{% elif maintenance %}
{# Missing-features batch, goal feature 2: force every response in this
   vhost to HTTP 503. **Empirically corrected during this feature's live
   verification** (a real curl against a real vhost, not just reasoned
   about): the Apache mod_rewrite idiom this project's other rewrite-based
   features use elsewhere (substitution "-" + [R=503], relying on a
   separate `errorpage 503` directive to supply the body) does NOT work
   the same way on this server's OpenLiteSpeed -- confirmed live that a
   bare "-" substitution with [R=503] short-circuits straight to OLS's
   own generic built-in 503 page and skips BOTH `errorpage` substitution
   AND context-level `extraHeaders`, even though both directives are
   present and independently confirmed reachable/working when fetched
   directly. The fix that IS confirmed working live: rewrite the request
   to the maintenance page's own URL as a real substitution target (not
   "-"), which routes through OLS's normal content-serving pipeline (so
   `extraHeaders`'s Retry-After actually applies) while [R=503] still
   tags the response with the correct status code -- `errorpage 503`
   above becomes redundant for THIS path (kept anyway since it's what
   still fires for a 503 OLS generates on its own, e.g. from an
   overloaded backend, outside of maintenance mode) but is no longer
   what supplies the maintenance page's body. The error-pages context
   itself is excluded from the rewrite so the substitution target isn't
   rewritten again into a loop. Bypassed by the ACME challenge path (so
   certbot renewal is never blocked during maintenance -- the goal's
   explicit requirement) and by a matching ?fh_bypass=<token> in the
   query string. #}
  rules                   <<<END_boron_rules
RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
RewriteCond %{REQUEST_URI} !^/\.boron-error-pages/
RewriteCond %{QUERY_STRING} !(^|&){{ maintenance.bypass_query_param }}={{ maintenance.bypass_token }}(&|$)
RewriteRule ^ /.boron-error-pages/{{ maintenance.page_name }} [R=503,L]
END_boron_rules
{% elif forwarding %}
{# Phase 8 feature 4: whole-domain 301/302 forwarding. Everything except the
   ACME HTTP-01 challenge path (so SSL stays issuable/renewable for a forwarded
   domain) is redirected to the target URL. keep_path appends the original
   request URI; otherwise every path collapses to the bare target. The target
   is validated http(s) with no regex metacharacters (validate_redirect_target),
   so it's a safe rewrite replacement string. #}
  rules                   <<<END_boron_rules
RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
{% if forwarding.keep_path %}
RewriteRule ^/?(.*)$ {{ forwarding.target_url }}/$1 [R={{ forwarding.status_code }},L]
{% else %}
RewriteRule ^/?(.*)$ {{ forwarding.target_url }} [R={{ forwarding.status_code }},L]
{% endif %}
END_boron_rules
{% elif hotlink or redirects %}
  {# Phase 4 feature 2 (hotlink) and Phase 3 feature 7 (redirects) are
     independent, both may be active at once -- unlike "suspended",
     which wins exclusively over everything else. Hotlink rules run
     first (a blocked hotlinked image should never fall through to a
     redirect rule). #}
  rules                   <<<END_boron_rules
{% if hotlink %}
  {# Standard mod_rewrite hotlink-protection recipe: block only when
     Referer is present (empty Referer always allowed -- direct nav,
     bookmarks, privacy tools that strip it) AND doesn't match this
     domain or any allow-listed one. All RewriteCond lines AND together
     by default (no [OR]) -- exactly "not empty AND not own-domain AND
     not each allowed domain" all simultaneously true triggers the
     block. #}
RewriteCond %{HTTP_REFERER} !^$
{% for d in hotlink.allowed_domains_escaped %}
RewriteCond %{HTTP_REFERER} !^https?://([^/]+\.)?{{ d }}(/|$) [NC]
{% endfor %}
RewriteRule \.({{ hotlink.extensions }})$ - [F,L]
{% endif %}
{% for r in redirects or [] %}
RewriteRule ^{{ r.regex_path }}$ {{ r.target_url }} [R={{ r.status_code }},L]
{% endfor %}
END_boron_rules
{% endif %}
}

{# Per-domain log files, not shared per-account: each domain is now its own
   vhost, and OLS logging isn't safe/meaningful to point multiple
   concurrently-active vhost definitions at the exact same log file. #}
errorlog {{ home_dir }}/logs/{{ vhost_name }}-error.log {
  useServer               0
  logLevel                WARN
  rollingSize             10M
}

accessLog {{ home_dir }}/logs/{{ vhost_name }}-access.log {
  useServer               0
  rollingSize             10M
  keepDays                30
}

vhssl {
  keyFile                 {{ ssl_key_file }}
  certFile                {{ ssl_cert_file }}
}
