#
# Forgehost-managed file. Regenerated in full from the control-plane DB on
# every account/domain change (ARCHITECTURE.md SS6 - declarative
# regeneration, not incremental text patching of a shared file).
# Manual edits here will be overwritten on the next change.
#

serverName                       {{ server_name }}
user                              nobody
group                             nogroup
priority                          0
autoRestart                       1
chrootPath                        /
enableChroot                      0
inMemBufSize                      60M
swappingDir                       /tmp/lshttpd/swap
autoFix503                        1
gracefulRestartTimeout            300
mime                              conf/mime.properties
showVersionNumber                 0
adminEmails                       {{ admin_email }}
indexFiles                        index.html, index.php
disableWebAdmin                   0

errorlog logs/error.log {
        logLevel             WARN
        debugLevel           0
        rollingSize          10M
        enableStderrLog      1
}

accessLog logs/access.log {
        rollingSize          10M
        keepDays             30
        compressArchive      0
        logReferer           1
        logUserAgent         1
}

expires {
    enableExpires           1
    expiresByType            image/*=A604800,text/css=A604800,application/x-javascript=A604800,application/javascript=A604800,font/*=A604800,application/x-font-ttf=A604800
}

tuning{
    maxConnections               10000
    maxSSLConnections            10000
    connTimeout                  300
    maxKeepAliveReq              10000
    smartKeepAlive               0
    keepAliveTimeout             5
    sndBufSize                   0
    rcvBufSize                   0
    gzipStaticCompressLevel      6
    gzipMaxFileSize              10M
    eventDispatcher              best
    maxCachedFileSize            4096
    totalInMemCacheSize          20M
    maxMMapFileSize              256K
    totalMMapCacheSize           40M
    useSendfile                  1
    fileETag                     28
    SSLCryptoDevice              null
    maxReqURLLen                 32768
    maxReqHeaderSize             65536
    maxReqBodySize               2047M
    maxDynRespHeaderSize         32768
    maxDynRespSize                2047M
    enableGzipCompress           1
    enableBrCompress             4
    enableDynGzipCompress        1
    gzipCompressLevel            6
    brStaticCompressLevel        6
    compressibleTypes            default
    gzipAutoUpdateStatic         1
    gzipMinFileSize              300

    quicEnable                   1
    quicShmDir                   /dev/shm
}

accessDenyDir{
    dir                  /
    dir                  /etc/*
    dir                  /dev/*
    dir                  conf/*
    dir                  admin/conf/*
}

fileAccessControl{
    followSymbolLink                            1
    checkSymbolLink                             0
    requiredPermissionMask                      000
    restrictedPermissionMask                    000
}

perClientConnLimit{
    staticReqPerSec                          0
    dynReqPerSec                             0
    outBandwidth                             0
    inBandwidth                              0
    softLimit                                10000
    hardLimit                                10000
    gracePeriod                              15
    banPeriod                                300
}

CGIRLimit{
    maxCGIInstances                         20
    minUID                                  {{ min_uid }}
    minGID                                  {{ min_gid }}
    priority                                0
    CPUSoftLimit                            10
    CPUHardLimit                            50
    memSoftLimit                            2047M
    memHardLimit                            2047M
    procSoftLimit                           400
    procHardLimit                           450
}

accessControl{
	allow                                   ALL
	deny
}

extProcessor lsphp{
    type                            lsapi
    address                         uds://tmp/lshttpd/lsphp.sock
    maxConns                        10
    env                              PHP_LSAPI_CHILDREN=10
    env                              LSAPI_AVOID_FORK=200M
    initTimeout                     60
    retryTimeout                    0
    persistConn                     1
    respBuffer                      0
    autoStart                       1
    path                            lsphp{{ default_php_version_nodot }}/bin/lsphp
    backlog                         100
    instances                       1
    priority                        0
    memSoftLimit                    0
    memHardLimit                    0
    procSoftLimit                   1400
    procHardLimit                   1500
}

scriptHandler{
    add lsapi:lsphp  php
}

{% if webmail_hostname %}
# Phase 2 feature 3: Roundcube, deployed once server-wide (not a
# per-account resource -- infrastructure like the extProcessor/vhost
# blocks above it, so it's static template content rather than generated
# from the accounts/domains loop below).
extProcessor roundcube_php{
    type                            lsapi
    address                         uds://tmp/lshttpd/roundcube_php.sock
    maxConns                        10
    env                              PHP_LSAPI_CHILDREN=10
    initTimeout                     60
    retryTimeout                    0
    persistConn                     1
    respBuffer                      0
    autoStart                       1
    path                            {{ webmail_lsphp_path }}
    backlog                         100
    instances                       1
    priority                        0
    extUser                         www-data
    extGroup                        www-data
    memSoftLimit                    256M
    memHardLimit                    512M
    procSoftLimit                   50
    procHardLimit                   75
}

virtualHost roundcube{
    vhRoot                   {{ webmail_docroot }}/
    allowSymbolLink          1
    enableScript             1
    restrained                1
    {# setUIDMode 0 (server uid), not 2 (DocRoot UID): Roundcube is one
       shared app, not a multi-tenant hosting account, so there's no
       per-tenant uid isolation to derive from docroot ownership --
       isolation here comes entirely from the roundcube_php extProcessor's
       extUser/extGroup=www-data above. Mode 2 additionally requires the
       docroot's own uid/gid to clear CGIRLimit's minUID/minGID, which the
       package-owned (root:root) directory doesn't -- confirmed live: the
       first bootstrap attempt failed openlitespeed -t on exactly that
       check, the same failure class Phase 1 hit with OLS's stock Example
       vhost. #}
    setUIDMode               0
    configFile               conf/vhosts/roundcube/vhconf.conf
}
{% endif %}

{% if pma_hostname %}
# Phase 3 feature 3: phpMyAdmin, deployed once server-wide (same
# static-infra pattern as Roundcube above) -- gated on pma_hostname so an
# operator who never runs bootstrap_pma sees no reference to it at all.
extProcessor pma_php{
    type                            lsapi
    address                         uds://tmp/lshttpd/pma_php.sock
    maxConns                        10
    env                              PHP_LSAPI_CHILDREN=10
    initTimeout                     60
    retryTimeout                    0
    persistConn                     1
    respBuffer                      0
    autoStart                       1
    path                            {{ pma_lsphp_path }}
    backlog                         100
    instances                       1
    priority                        0
    extUser                         www-data
    extGroup                        www-data
    memSoftLimit                    256M
    memHardLimit                    512M
    procSoftLimit                   50
    procHardLimit                   75
}

virtualHost phpmyadmin{
    vhRoot                   {{ pma_docroot }}/
    allowSymbolLink          1
    enableScript             1
    restrained                1
    setUIDMode               0
    configFile               conf/vhosts/phpmyadmin/vhconf.conf
}
{% endif %}

{# Phase 2 feature 4: one extProcessor per ACCOUNT (php_version is an
   account-level setting, so every domain that account owns shares this
   one LSAPI backend), defined at server level so it can be referenced by
   name from each of that account's per-domain vhost files below. #}
{% for acc in account_procs %}
extProcessor {{ acc.php_app_name }}{
    type                            lsapi
    address                         uds://tmp/lshttpd/{{ acc.php_app_name }}.sock
    maxConns                        10
    env                              PHP_LSAPI_CHILDREN=10
    initTimeout                     60
    retryTimeout                    0
    persistConn                     1
    respBuffer                      0
    autoStart                       1
    path                            {{ acc.lsphp_path }}
    backlog                         100
    instances                       1
    priority                        0
    extUser                         {{ acc.username }}
    extGroup                        {{ acc.username }}
    memSoftLimit                    {{ mem_soft_limit }}
    memHardLimit                    {{ mem_hard_limit }}
    procSoftLimit                   {{ proc_soft_limit }}
    procHardLimit                   {{ proc_hard_limit }}
}
{% endfor %}

{# One vhost per DOMAIN, not per account -- the actual fix for Phase 1's
   gap (every domain under an account used to serve the same public_html
   content regardless of its own docroot). vhRoot stays the account's home
   dir (OLS's own relative-path base for this vhost's config/logs, distinct
   from docRoot which vhconf.conf sets to the domain's real docroot). #}
{% for vh in domain_vhosts %}
virtualHost {{ vh.vhost_name }}{
    vhRoot                   {{ vh.account_home }}/
    allowSymbolLink          1
    enableScript             1
    restrained               1
    setUIDMode               2
    configFile               conf/vhosts/{{ vh.vhost_name }}/vhconf.conf
}
{% endfor %}

listener HTTP{
    address                  *:80
    secure                   0
{% if webmail_hostname %}
    map                      roundcube {{ webmail_hostname }}
{% endif %}
{% if pma_hostname %}
    map                      phpmyadmin {{ pma_hostname }}
{% endif %}
{% for vh in domain_vhosts %}
    map                      {{ vh.vhost_name }} {{ vh.domain }}
{% endfor %}
}

listener HTTPS{
    address                  *:443
    secure                   1
    keyFile                  {{ default_ssl_key }}
    certFile                 {{ default_ssl_cert }}
{% if webmail_hostname %}
    map                      roundcube {{ webmail_hostname }}
{% endif %}
{% if pma_hostname %}
    map                      phpmyadmin {{ pma_hostname }}
{% endif %}
{% for vh in domain_vhosts %}
    map                      {{ vh.vhost_name }} {{ vh.domain }}
{% endfor %}
}

module cache {
    ls_enabled          1
    checkPrivateCache   1
    checkPublicCache    1
    maxCacheObjSize     10000000
    maxStaleAge         200
    qsCache             1
    reqCookieCache      1
    respCookieCache     1
    ignoreReqCacheCtrl  1
    ignoreRespCacheCtrl 0
    enableCache         0
    expireInSeconds     3600
    enablePrivateCache  0
    privateExpireInSeconds 3600
}
