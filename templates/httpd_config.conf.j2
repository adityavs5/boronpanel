#
# Boron-managed file. Regenerated in full from the control-plane DB on
# every account/domain change (ARCHITECTURE.md SS6 - declarative
# regeneration, not incremental text patching of a shared file).
# Manual edits here will be overwritten on the next change.
#

serverName                       {{ server_name }}
user                              nobody
group                             nogroup
priority                          0
autoRestart                       1
chrootPath                        /
enableChroot                      0
inMemBufSize                      60M
swappingDir                       /tmp/lshttpd/swap
autoFix503                        1
gracefulRestartTimeout            300
mime                              conf/mime.properties
showVersionNumber                 0
adminEmails                       {{ admin_email }}
indexFiles                        index.html, index.php
disableWebAdmin                   0

# Phase 6b: OLS native Namespace Container feature (docs/NAMESPACE-DESIGN.md,
# docs/NAMESPACE-ANSWERS.md). This is a server-level, opt-OUT mechanism --
# confirmed via OLS's own docs/source (lsnsctl) that there is no per-account
# allowlist, only a denylist (ns_disabled_uids.conf) gated by a min_uid floor
# (lsns.conf). The installer initializes the floor to Ubuntu's UID_MIN (1000)
# so hosted accounts are eligible, while explicit lsnsctl disable-uid entries
# remain the opt-out for service or canary accounts. The floor and denylist
# are runtime state and are preserved when the installer is re-run.
namespace                         2
namespaceConf                     conf/nsconf.conf

errorlog logs/error.log {
        logLevel             WARN
        debugLevel           0
        rollingSize          10M
        enableStderrLog      1
}

accessLog logs/access.log {
        rollingSize          10M
        keepDays             30
        compressArchive      0
        logReferer           1
        logUserAgent         1
}

expires {
    enableExpires           1
    expiresByType            image/*=A604800,text/css=A604800,application/x-javascript=A604800,application/javascript=A604800,font/*=A604800,application/x-font-ttf=A604800
}

tuning{
    maxConnections               10000
    maxSSLConnections            10000
    connTimeout                  300
    maxKeepAliveReq              10000
    smartKeepAlive               0
    keepAliveTimeout             5
    sndBufSize                   0
    rcvBufSize                   0
    gzipStaticCompressLevel      6
    gzipMaxFileSize              10M
    eventDispatcher              best
    maxCachedFileSize            4096
    totalInMemCacheSize          20M
    maxMMapFileSize              256K
    totalMMapCacheSize           40M
    useSendfile                  1
    fileETag                     28
    SSLCryptoDevice              null
    maxReqURLLen                 32768
    maxReqHeaderSize             65536
    maxReqBodySize               2047M
    maxDynRespHeaderSize         32768
    maxDynRespSize                2047M
    enableGzipCompress           1
    enableBrCompress             4
    enableDynGzipCompress        1
    gzipCompressLevel            6
    brStaticCompressLevel        6
    compressibleTypes            default
    gzipAutoUpdateStatic         1
    gzipMinFileSize              300

    quicEnable                   1
    quicShmDir                   /dev/shm
}

accessDenyDir{
    dir                  /
    dir                  /etc/*
    dir                  /dev/*
    dir                  conf/*
    dir                  admin/conf/*
}

fileAccessControl{
    followSymbolLink                            1
    checkSymbolLink                             0
    requiredPermissionMask                      000
    restrictedPermissionMask                    000
}

perClientConnLimit{
    staticReqPerSec                          0
    dynReqPerSec                             0
    outBandwidth                             0
    inBandwidth                              0
    softLimit                                10000
    hardLimit                                10000
    gracePeriod                              15
    banPeriod                                300
}

CGIRLimit{
    maxCGIInstances                         20
    minUID                                  {{ min_uid }}
    minGID                                  {{ min_gid }}
    priority                                0
    CPUSoftLimit                            10
    CPUHardLimit                            50
    memSoftLimit                            2047M
    memHardLimit                            2047M
    procSoftLimit                           400
    procHardLimit                           450
}

{# Phase 2+3 feature 3 (real-IP rails): Cloudflare edge ranges are marked
   TRUSTED (trailing "T") so the listeners' `useIpInProxyHeader 2` restores
   the real visitor IP from X-Forwarded-For ONLY when the request actually
   came from a Cloudflare edge -- spoofing the header from anywhere else is
   ignored. Absent ranges (feature not yet configured / rolled back) -> plain
   `allow ALL`, byte-identical to before this feature. #}
accessControl{
	allow                                   ALL{% for cidr in cloudflare_trusted_ips %}, {{ cidr }}T{% endfor %}

	deny
}

extProcessor lsphp{
    type                            lsapi
    address                         uds://tmp/lshttpd/lsphp.sock
    maxConns                        10
    env                              PHP_LSAPI_CHILDREN=10
    env                              LSAPI_AVOID_FORK=200M
    initTimeout                     60
    retryTimeout                    0
    persistConn                     1
    respBuffer                      0
    autoStart                       1
    path                            lsphp{{ default_php_version_nodot }}/bin/lsphp
    backlog                         100
    instances                       1
    priority                        0
    memSoftLimit                    0
    memHardLimit                    0
    procSoftLimit                   1400
    procHardLimit                   1500
}

scriptHandler{
    add lsapi:lsphp  php
}

{% if webmail_hostname %}
# Phase 2 feature 3: Roundcube, deployed once server-wide (not a
# per-account resource -- infrastructure like the extProcessor/vhost
# blocks above it, so it's static template content rather than generated
# from the accounts/domains loop below).
extProcessor roundcube_php{
    type                            lsapi
    address                         uds://tmp/lshttpd/roundcube_php.sock
    maxConns                        10
    env                              PHP_LSAPI_CHILDREN=10
    initTimeout                     60
    retryTimeout                    0
    persistConn                     1
    respBuffer                      0
    autoStart                       1
    path                            {{ webmail_lsphp_path }}
    backlog                         100
    instances                       1
    priority                        0
    extUser                         www-data
    extGroup                        www-data
    memSoftLimit                    256M
    memHardLimit                    512M
    procSoftLimit                   50
    procHardLimit                   75
}

virtualHost roundcube{
    vhRoot                   {{ webmail_docroot }}/
    allowSymbolLink          1
    enableScript             1
    restrained                1
    {# setUIDMode 0 (server uid), not 2 (DocRoot UID): Roundcube is one
       shared app, not a multi-tenant hosting account, so there's no
       per-tenant uid isolation to derive from docroot ownership --
       isolation here comes entirely from the roundcube_php extProcessor's
       extUser/extGroup=www-data above. Mode 2 additionally requires the
       docroot's own uid/gid to clear CGIRLimit's minUID/minGID, which the
       package-owned (root:root) directory doesn't -- confirmed live: the
       first bootstrap attempt failed openlitespeed -t on exactly that
       check, the same failure class Phase 1 hit with OLS's stock Example
       vhost. #}
    setUIDMode               0
    configFile               conf/vhosts/roundcube/vhconf.conf
}
{% endif %}

{% if pma_hostname %}
# Phase 3 feature 3: phpMyAdmin, deployed once server-wide (same
# static-infra pattern as Roundcube above) -- gated on pma_hostname so an
# operator who never runs bootstrap_pma sees no reference to it at all.
extProcessor pma_php{
    type                            lsapi
    address                         uds://tmp/lshttpd/pma_php.sock
    maxConns                        10
    env                              PHP_LSAPI_CHILDREN=10
    initTimeout                     60
    retryTimeout                    0
    persistConn                     1
    respBuffer                      0
    autoStart                       1
    path                            {{ pma_lsphp_path }}
    backlog                         100
    instances                       1
    priority                        0
    extUser                         www-data
    extGroup                        www-data
    memSoftLimit                    256M
    memHardLimit                    512M
    procSoftLimit                   50
    procHardLimit                   75
}

virtualHost phpmyadmin{
    vhRoot                   {{ pma_docroot }}/
    allowSymbolLink          1
    enableScript             1
    restrained                1
    setUIDMode               0
    configFile               conf/vhosts/phpmyadmin/vhconf.conf
}
{% endif %}

{# Phase 2 feature 4: one extProcessor per ACCOUNT (php_version is an
   account-level setting, so every domain that account owns shares this
   one LSAPI backend), defined at server level so it can be referenced by
   name from each of that account's per-domain vhost files below. #}
{% for acc in account_procs %}
extProcessor {{ acc.php_app_name }}{
    type                            lsapi
    address                         uds://tmp/lshttpd/{{ acc.php_app_name }}.sock
    maxConns                        10
    env                              PHP_LSAPI_CHILDREN=10
    {# Security fix (Phase 6a research finding): confirmed empirically
       (lsphp -i / a live test script) that this build's sys_temp_dir ini
       directive is empty, so sys_get_temp_dir() -- and anything that
       calls it, e.g. tempnam()/Imagick/PHPMailer attachment scratch files
       -- falls back to the system /tmp that vhost.conf.j2's open_basedir
       no longer includes. Confirmed TMPDIR is honored by this exact lsphp
       build (same live test) -- setting it here redirects that fallback
       to this account's own private tmp dir instead of failing with an
       open_basedir violation. #}
    env                              TMPDIR={{ acc.home_dir }}/tmp
{% if acc.get('php_scan_dir') %}
    {# Per-account extension selection (daemon/phpext.py): PHP_INI_SCAN_DIR
       *replaces* the compiled-in mods-available dir, so this account's own
       root-owned ~/.php/<ver>/conf.d -- populated with symlinks to exactly
       the stock snippets it enabled -- decides what loads. Under the HOME
       (not /etc) because that's all a namespaced account can see. #}
    env                              PHP_INI_SCAN_DIR={{ acc.php_scan_dir }}
{% endif %}
    initTimeout                     60
    retryTimeout                    0
    persistConn                     1
    respBuffer                      0
    autoStart                       1
    path                            {{ acc.lsphp_path }}
    backlog                         100
    instances                       1
    priority                        0
    extUser                         {{ acc.username }}
    extGroup                        {{ acc.username }}
    memSoftLimit                    {{ mem_soft_limit }}
    memHardLimit                    {{ mem_hard_limit }}
    procSoftLimit                   {{ proc_soft_limit }}
    procHardLimit                   {{ proc_hard_limit }}
}
{% endfor %}

{# Phase 7a features 1/2: NodeJS/Python app hosting. One "Web Server
   (Proxy)" external app per app-bound domain, declared server-wide (same
   reason account_procs is: referenced by name from that domain's own
   vhost Proxy Context) -- address is always 127.0.0.1, never a wildcard
   or externally-reachable interface, so the app's own port is only ever
   reachable through this OLS-terminated vhost, never directly from
   another account or the public internet. #}
{% for vh in domain_vhosts %}
{% if vh.get('app_proxy') %}
{# type "proxy", not the admin-console label "Web Server (Proxy)" --
   confirmed empirically against this server's real openlitespeed binary:
   "type web" fails `openlitespeed -t` with "Unknown external processor
   <type>: web"; `strings` on the binary itself lists "proxy" as the real
   accepted keyword, matching the Proxy Context's own `type proxy` value. #}
extProcessor {{ vh.app_proxy.handler_name }}{
    type                            proxy
    address                         127.0.0.1:{{ vh.app_proxy.port }}
    maxConns                        50
    initTimeout                     60
    retryTimeout                    0
    respBuffer                      0
}
{% endif %}
{% endfor %}

{# One vhost per DOMAIN, not per account -- the actual fix for Phase 1's
   gap (every domain under an account used to serve the same public_html
   content regardless of its own docroot). vhRoot stays the account's home
   dir (OLS's own relative-path base for this vhost's config/logs, distinct
   from docRoot which vhconf.conf sets to the domain's real docroot). #}
{% for vh in domain_vhosts %}
virtualHost {{ vh.vhost_name }}{
    vhRoot                   {{ vh.account_home }}/
    allowSymbolLink          1
    enableScript             1
    restrained               1
    setUIDMode               2
    configFile               conf/vhosts/{{ vh.vhost_name }}/vhconf.conf
}
{% endfor %}

listener HTTP{
    address                  *:80
    secure                   0
{% if cloudflare_trusted_ips %}
    useIpInProxyHeader       2
{% endif %}
{% if webmail_hostname %}
    map                      roundcube {{ webmail_hostname }}
{% endif %}
{% if pma_hostname %}
    map                      phpmyadmin {{ pma_hostname }}
{% endif %}
{% for vh in domain_vhosts %}
    {# Missing-features batch, goal feature 3: a wildcard-enabled domain adds
       "*.<domain>" as a second name in the SAME map entry -- confirmed
       against this server's installed OLS docs (Listeners_General_Help.html):
       "'*.mydomain.com' will match all subdomains of mydomain.com", and any
       OTHER domain/subdomain with its own explicit map entry elsewhere in
       this listener still wins for its own exact hostname (OLS's own
       documented most-specific-match-first lookup), so an existing explicit
       subdomain is never shadowed by enabling this. #}
    map                      {{ vh.vhost_name }} {{ vh.domain }}{{ (", www." + vh.domain) if vh.get("www_alias") else "" }}{{ (", *." + vh.domain) if vh.get('wildcard') else "" }}
{% endfor %}
}

listener HTTPS{
    address                  *:443
    secure                   1
    keyFile                  {{ default_ssl_key }}
    certFile                 {{ default_ssl_cert }}
{% if cloudflare_trusted_ips %}
    useIpInProxyHeader       2
{% endif %}
{% if webmail_hostname %}
    map                      roundcube {{ webmail_hostname }}
{% endif %}
{% if pma_hostname %}
    map                      phpmyadmin {{ pma_hostname }}
{% endif %}
{% for vh in domain_vhosts %}
    {# Missing-features batch, goal feature 3: a wildcard-enabled domain adds
       "*.<domain>" as a second name in the SAME map entry -- confirmed
       against this server's installed OLS docs (Listeners_General_Help.html):
       "'*.mydomain.com' will match all subdomains of mydomain.com", and any
       OTHER domain/subdomain with its own explicit map entry elsewhere in
       this listener still wins for its own exact hostname (OLS's own
       documented most-specific-match-first lookup), so an existing explicit
       subdomain is never shadowed by enabling this. #}
    map                      {{ vh.vhost_name }} {{ vh.domain }}{{ (", www." + vh.domain) if vh.get("www_alias") else "" }}{{ (", *." + vh.domain) if vh.get('wildcard') else "" }}
{% endfor %}
}

module cache {
    ls_enabled          1
    checkPrivateCache   1
    checkPublicCache    1
    maxCacheObjSize     10000000
    maxStaleAge         200
    qsCache             1
    reqCookieCache      1
    respCookieCache     1
    ignoreReqCacheCtrl  1
    ignoreRespCacheCtrl 0
    enableCache         0
    expireInSeconds     3600
    enablePrivateCache  0
    privateExpireInSeconds 3600
}
{% if waf_enabled %}

# Phase 5 feature 7: ModSecurity/WAF (daemon/waf.py). Confirmed live on this
# server that OpenLiteSpeed has NO per-vhost ModSecurity configuration --
# the engine and its rule files load once, server-wide, in this one
# `module mod_security` block (https://forum.openlitespeed.org/threads/
# mod-security-at-vhost-level.5401/: "I don't think there's a way to apply
# modsecurity by user/virtual host on OpenLiteSpeed" -- confirmed correct
# by testing). Per-domain enable/disable and per-domain custom rules are
# therefore both implemented as conditional SecRule chains keyed off the
# Host header (`ctl:ruleEngine=Off` for disable, a matching rule for a
# custom block) -- the engine itself is global, but individual rules can
# still be scoped to one domain via ModSecurity's own rule language, which
# is the actual mechanism this feature relies on for "per domain" control.
module mod_security {
    ls_enabled          1
    modsecurity         on
    modsecurity_rules   `SecRuleEngine On
SecRequestBodyAccess On
SecAuditEngine RelevantOnly
SecAuditLogParts ABCEFHJKZ
SecAuditLogType Serial
SecAuditLog {{ waf_audit_log }}
{% for override in waf_domain_overrides %}
SecRule REQUEST_HEADERS:Host "@streq {{ override.domain }}" "id:{{ 9000000 + loop.index }},phase:1,pass,nolog,ctl:ruleEngine=Off"
{% endfor %}
{% for rule in waf_custom_rules %}
SecRule REQUEST_HEADERS:Host "@streq {{ rule.domain }}" "id:{{ 9100000 + loop.index }},phase:2,chain"
SecRule {{ rule.target }} "@rx {{ rule.pattern }}" "t:none,deny,status:403,msg:'boron-custom-rule-{{ rule.id }}'"
{% endfor %}`
    modsecurity_rules_file   {{ waf_rules_file }}
}
{% endif %}
